{
  "name": "fanfic-downloader",
  "version": "1.1.0",
  "description": "A Firefox plugin for downloading fan fiction from popular sites.",
  "scripts": {
    "build": "vite build && node scripts/zip-dist.mjs && node scripts/zip-source.mjs",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-versions": "node scripts/check-version-sync.mjs",
    "lint": "eslint src",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Serenacula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serenacula/fanfic-downloader.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/pdfmake": "^0.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.10",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "fflate": "^0.8.2",
    "pdfmake": "^0.3.7"
  }
}
